# Public values embedded into the browser bundle during the Next.js build.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Worker-only runtime values. Store secrets with Wrangler in production.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
TURNSTILE_SECRET=
ORIGIN_AUTH_TOKEN=
