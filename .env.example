# Copy this file to .env in the repository root. Never commit a populated copy.
# Supply your key and exact chat model identifiers from your provider.
GEMINI_API_KEY=
LLM_MODEL=
LLM_MODEL_LITE=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSIONS=1024
EMBEDDING_THREADS=4

# Local service. CORS_ORIGINS accepts JSON or comma-separated explicit origins.
APP_ENV=development
LOG_LEVEL=INFO
GIT_SHA=unknown
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Optional fallback. Enabled only when both values are set.
LLM_MODEL_FALLBACK=
GROQ_API_KEY=

# Direct Gemini works with this disabled. Enabling requires URL and token.
USE_AI_GATEWAY=false
CF_AI_GATEWAY_URL=
CF_AI_GATEWAY_TOKEN=
CF_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Local Qdrant is the default. Set URL and API key for Qdrant Cloud.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=met_objects
QDRANT_VISITOR_COLLECTION=met_visitor_info
MET_API_BASE=https://collectionapi.metmuseum.org/public/collection/v1
INGEST_MAX_OBJECTS=10000
EMBEDDING_BATCH_SIZE=32
DATA_DIR=data

# Optional tracing. All three values are required to enable Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Optional public dataset, publishing token, and object storage.
HF_DATASET_REPO=
HF_TOKEN=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Used by later deployment commands, not required for local startup.
GCP_REGION=
